; suite8 name=s7_23 seed=0 target=(bvxor (bvnot (bvneg x)) (bvsub x #xFF))
(set-logic BV)
(synth-fun f ((x (BitVec 8)) (y (BitVec 8))) (BitVec 8)
  ((Start (BitVec 8) (x y #x00 #x01 #xFF (bvnot Start) (bvneg Start) (bvand Start Start) (bvor Start Start) (bvxor Start Start) (bvadd Start Start) (bvsub Start Start) (bvshl Start Start) (bvlshr Start Start)))))
(constraint (= (f #x00 #x00) #xFE))
(constraint (= (f #xFF #xFF) #xFE))
(constraint (= (f #xEB #xE2) #x06))
(constraint (= (f #xFD #xD0) #x02))
(constraint (= (f #x19 #xF5) #x02))
(constraint (= (f #x45 #x20) #x02))
(check-synth)
