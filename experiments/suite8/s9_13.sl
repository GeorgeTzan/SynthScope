; suite8 name=s9_13 seed=0 target=(bvor (bvnot (bvshl y #x01)) (bvor (bvneg y) x))
(set-logic BV)
(synth-fun f ((x (BitVec 8)) (y (BitVec 8))) (BitVec 8)
  ((Start (BitVec 8) (x y #x00 #x01 #xFF (bvnot Start) (bvneg Start) (bvand Start Start) (bvor Start Start) (bvxor Start Start) (bvadd Start Start) (bvsub Start Start) (bvshl Start Start) (bvlshr Start Start)))))
(constraint (= (f #x00 #x00) #xFF))
(constraint (= (f #xFF #xFF) #xFF))
(constraint (= (f #x8E #x73) #x9F))
(constraint (= (f #x77 #xC8) #x7F))
(constraint (= (f #x31 #x21) #xFF))
(constraint (= (f #x0C #xDD) #x6F))
(check-synth)
