; suite8 name=s9_15 seed=0 target=(bvsub (bvnot (bvsub #x01 #xFF)) (bvor (bvneg y) #x01))
(set-logic BV)
(synth-fun f ((x (BitVec 8)) (y (BitVec 8))) (BitVec 8)
  ((Start (BitVec 8) (x y #x00 #x01 #xFF (bvnot Start) (bvneg Start) (bvand Start Start) (bvor Start Start) (bvxor Start Start) (bvadd Start Start) (bvsub Start Start) (bvshl Start Start) (bvlshr Start Start)))))
(constraint (= (f #x00 #x00) #xFC))
(constraint (= (f #xFF #xFF) #xFC))
(constraint (= (f #xF1 #x31) #x2E))
(constraint (= (f #xFE #xEE) #xEA))
(constraint (= (f #x6C #xE3) #xE0))
(constraint (= (f #xC1 #x6D) #x6A))
(check-synth)
